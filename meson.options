# Naming an engine asks for a fuzzing build; a session fuzzes exactly one ISA.
option(
    'fuzz',
    type: 'string',
    value: '',
    description: 'engine to fuzz; naming one builds the fuzzers and nothing else',
)

option(
    'fuzz_link_args',
    type: 'string',
    value: '',
    description: 'the C++ library supplying main(), from $LIB_FUZZING_ENGINE',
)
