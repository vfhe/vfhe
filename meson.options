# Naming an engine asks for a fuzzing build; a session fuzzes exactly one ISA.
option(
    'fuzz',
    type: 'string',
    value: '',
    description: 'engine to fuzz; naming one builds the fuzzers and nothing else',
)

option(
    'fuzz_link_args',
    type: 'string',
    value: '',
    description: 'the C++ library supplying main(), from $LIB_FUZZING_ENGINE',
)

# A GPU joins no engine: its sources build into one extension of their own.
option(
    'cuda',
    type: 'feature',
    value: 'auto',
    description: 'the CUDA extension _vfhe_cuda; auto builds it when nvcc is found',
)
